# Run: python scripts/init_env.py. It creates .env once with six independent secrets.
# This file contains no working credentials. Never commit .env or secret files.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./seo-autonomous.db
API_TOKEN=
APPROVAL_TOKEN=
ADMIN_TOKEN=

# Compose uses an owner only for migrations. API and worker credentials are
# distinct capabilities; never reuse either password or database login.
POSTGRES_USER=seo_owner
POSTGRES_PASSWORD=
POSTGRES_DB=seo
POSTGRES_API_USER=seo_api
POSTGRES_API_PASSWORD=
POSTGRES_WORKER_USER=seo_worker
POSTGRES_WORKER_PASSWORD=
API_PORT=8000

# Required by every production owner migration. Copy from the independently
# reviewed release/target record; do not derive these inside the migration job.
# SEO_RELEASE_IMAGE=registry.example/seo@sha256:<64-lowercase-hex>
# SEO_MIGRATION_EXPECTED_DATABASE=seo_production
# SEO_MIGRATION_EXPECTED_SYSTEM_IDENTIFIER=<postgresql-system-identifier>
# SEO_MIGRATION_MODE=upgrade
# SEO_MIGRATION_EXPECTED_SCHEMA_HEADS=0001_canonical

# Authority is intentionally independent from running recurring observations.
AUTONOMY_LEVEL=1
PRODUCTION_ENABLED=false
SHADOW_MODE=true
PROVIDER_MODE=fixture
AGENT_MODE=fixture
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
SCHEDULER_LEASE_SECONDS=300
MAX_DAILY_ACTIONS=5
MAX_AGENT_TURNS=4
MAX_AGENT_CALLS_PER_RUN=8
MAX_DAILY_COST_USD=5.0
MAX_CRAWL_PAGES=50
MAX_PAGES_PER_CRAWL=50
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_BYTES=2000000
LOG_LEVEL=INFO

# Set explicitly for a live site; unavailable sources remain unknown.
# Live model use also requires a verified site model-price-bound via its admin endpoint.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json
# GSC_PROPERTY=
# GA4_PROPERTY_ID=
# WORDPRESS_URL=
# WORDPRESS_USERNAME=
# WORDPRESS_APPLICATION_PASSWORD=

# Optional independent benchmark verifier. Mount only the public key read-only.
# BENCHMARK_EVALUATOR_PUBLIC_KEY_HOST_FILE=./secrets/benchmark-evaluator-public.pem
# BENCHMARK_EVALUATOR_PUBLIC_KEY_FILE=/run/secrets/benchmark-evaluator-public.pem
# BENCHMARK_EVALUATOR_KEY_ID=independently-agreed-key-id
# BENCHMARK_EXPECTED_DEFINITION_SHA256=
# BENCHMARK_EXPECTED_SOURCE_FINGERPRINT=
# BENCHMARK_EXPECTED_EVALUATION_ID=
# BENCHMARK_EXPECTED_CHALLENGE_SHA256=
# BENCHMARK_EXPECTED_OBSERVATIONS_SHA256=
# BENCHMARK_EXPECTED_PREDICTIONS_SHA256=
# BENCHMARK_EXPECTED_TRUTH_COMMITMENT_SHA256=
# BENCHMARK_EXPECTED_EXECUTION_ENVIRONMENT_SHA256=
# BENCHMARK_ATTESTATION_MAX_AGE_HOURS=168

# Optional remote MCP profile: external issuer and public HTTPS resource required.
# MCP_PUBLIC_URL=https://seo-mcp.your-domain.example/mcp
# MCP_OAUTH_ISSUER=https://issuer.your-domain.example/
# MCP_ALLOWED_SUBJECTS=operator-subject-from-your-issuer
# MCP_OAUTH_PUBLIC_KEY_HOST_FILE=./secrets/mcp-public-key.pem
# MCP_PORT=8001
